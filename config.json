{
  "maxDesktops": 9,
  "followWindow": false,
  "autoCreateDesktops": true,
  "focusHighlight": true,
  "focusBorderColor": "#7BA7E1",
  "focusBorderWidth": 3,
  "focusFollowsMouse": true,
  "focusFollowsMouseDelayMs": 250,
  "layouts": {
    "thirds": {
      "left":   { "x": 0,     "y": 0, "width": 33.33, "height": 100 },
      "middle": { "x": 33.33, "y": 0, "width": 33.34, "height": 100 },
      "right":  { "x": 66.67, "y": 0, "width": 33.33, "height": 100 }
    },
    "wide": {
      "left":   { "x": 0,  "y": 0, "width": 25, "height": 100 },
      "middle": { "x": 25, "y": 0, "width": 50, "height": 100 },
      "right":  { "x": 75, "y": 0, "width": 25, "height": 100 }
    }
  },
  "defaultLayout": "wide",
  "appRules": [
    { "process": "ms-teams", "zone": "pane:left",   "titleContains": "Microsoft Teams", "delayMs": 500 },
    { "process": "ms-teams", "zone": "pane:middle", "titleExcludes": "Microsoft Teams", "delayMs": 1500 },
    { "process": "olk",      "zone": "pane:right",  "delayMs": 500 }
  ]
}
